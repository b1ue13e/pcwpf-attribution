    <text x="724" y="38" text-anchor="middle" font-family="'Tinos', 'Liberation Serif', 'DejaVu Serif', 'Times New Roman', serif" font-size="39" font-weight="bold" fill="#111111">Constraint Lifecycle Taxonomy</text>
    <text x="724" y="63" text-anchor="middle" font-family="'Tinos', 'Liberation Serif', 'DejaVu Serif', 'Times New Roman', serif" font-size="22" font-style="normal" fill="#111111">Five orthogonal dimensions for auditing physics-constrained forecasting studies</text>
  </g>

