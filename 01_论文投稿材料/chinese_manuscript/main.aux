\def\@LN@column{2}
\@writefile{toc}{\contentsline {paragraph}{训练损失物理代理时效错配敏感性 (图~\ref {fig:causal_ablation}c)}{14}{section*.24}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Kelmarsh 与 Hill of Towie 场站内样本量学习曲线（$N_{\text  {train}} \in \{500, 1000, 1500, 3000, 5000\}$，多随机种子均值与标准差）。场站内实验剥离了地形与样本量的混杂：在模型受限训练窗口下（$N_{\text  {train}} \le 1,000$），固定历史经验先验在两场站均取得更低的平均调度成本（Kelmarsh 降低 $-2.00\%$，Hill of Towie 降低 $-3.62\%$）；随着模型训练窗口扩大至 $N_{\text  {train}}=5,000$，该优势消退并发生轻微反转（Kelmarsh 升高 $+0.33\%$，Hill of Towie 升高 $+1.73\%$）。而在强正则化（$\lambda =1.0$）下，误设的打乱先验在所有样本规模下均造成严重损害（调度成本激增 $+43\%$ 至 $+98\%$）。}}{15}{figure.caption.18}\protected@file@percent }
\newlabel{fig:within_site_learning_curve}{{5}{15}{Kelmarsh 与 Hill of Towie 场站内样本量学习曲线（$N_{\text {train}} \in \{500, 1000, 1500, 3000, 5000\}$，多随机种子均值与标准差）。场站内实验剥离了地形与样本量的混杂：在模型受限训练窗口下（$N_{\text {train}} \le 1,000$），固定历史经验先验在两场站均取得更低的平均调度成本（Kelmarsh 降低 $-2.00\%$，Hill of Towie 降低 $-3.62\%$）；随着模型训练窗口扩大至 $N_{\text {train}}=5,000$，该优势消退并发生轻微反转（Kelmarsh 升高 $+0.33\%$，Hill of Towie 升高 $+1.73\%$）。而在强正则化（$\lambda =1.0$）下，误设的打乱先验在所有样本规模下均造成严重损害（调度成本激增 $+43\%$ 至 $+98\%$）。}{figure.caption.18}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces 连续先验退化与工程漂移敏感性响应曲面。(a) 真实先验与打乱先验的连续插值 $\alpha \in [0.0, 1.0]$，测定 Penmanshiel 上临界容错阈值约为 $\alpha ^* \approx 0.07$；(b) 机组气动老化额定容量折损：折损超过 10\% 即导致先验劣于无约束基准；(c) 风速计传感器标定漂移：Penmanshiel 在正向风速偏差达 $+15\%$ 内仍能维持微弱优势，而负向低估则系统性加剧短缺惩罚。}}{15}{figure.caption.19}\protected@file@percent }
\newlabel{fig:corruption_gradient}{{6}{15}{连续先验退化与工程漂移敏感性响应曲面。(a) 真实先验与打乱先验的连续插值 $\alpha \in [0.0, 1.0]$，测定 Penmanshiel 上临界容错阈值约为 $\alpha ^* \approx 0.07$；(b) 机组气动老化额定容量折损：折损超过 10\% 即导致先验劣于无约束基准；(c) 风速计传感器标定漂移：Penmanshiel 在正向风速偏差达 $+15\%$ 内仍能维持微弱优势，而负向低估则系统性加剧短缺惩罚。}{figure.caption.19}{}}
