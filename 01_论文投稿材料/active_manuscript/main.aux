\@writefile{toc}{\contentsline {paragraph}{Continuous Corruption Interpolation ($\alpha \in [0.0, 1.0]$)}{15}{section*.23}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Within-Site Learning Curves across Discrete Sample Sizes $N_{\text  {train}} \in \{500, 1000, 1500, 3000, 5000\}$ on Kelmarsh and Hill of Towie (Multi-seed means and standard deviations). Holding site topography and turbine hardware constant, authentic empirical priors yield lower dispatch costs in the tested sample-restricted regimes ($N_{\text  {train}} \in \{500, 1{,}000\}$, $-2.00\%$ on Kelmarsh and $-3.62\%$ on Hill of Towie at $N=500$). As training volume expands, this advantage attenuates; at the largest evaluated training budget ($N_{\text  {train}} = 5{,}000$), unconstrained data-driven models close the gap and slightly reverse the ranking (+0.33\% on Kelmarsh, +1.73\% on Hill of Towie). In contrast, form-matched scrambled priors under strong regularization ($\lambda =1.0$) induce severe dispatch cost penalties ($+43\%$ to $+98\%$) across all evaluated sample regimes.}}{16}{figure.caption.19}\protected@file@percent }
\newlabel{fig:within_site_learning_curve}{{3}{16}{Within-Site Learning Curves across Discrete Sample Sizes $N_{\text {train}} \in \{500, 1000, 1500, 3000, 5000\}$ on Kelmarsh and Hill of Towie (Multi-seed means and standard deviations). Holding site topography and turbine hardware constant, authentic empirical priors yield lower dispatch costs in the tested sample-restricted regimes ($N_{\text {train}} \in \{500, 1{,}000\}$, $-2.00\%$ on Kelmarsh and $-3.62\%$ on Hill of Towie at $N=500$). As training volume expands, this advantage attenuates; at the largest evaluated training budget ($N_{\text {train}} = 5{,}000$), unconstrained data-driven models close the gap and slightly reverse the ranking (+0.33\% on Kelmarsh, +1.73\% on Hill of Towie). In contrast, form-matched scrambled priors under strong regularization ($\lambda =1.0$) induce severe dispatch cost penalties ($+43\%$ to $+98\%$) across all evaluated sample regimes}{figure.caption.19}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Continuous Prior Corruption and Engineering Drift Severity Response Curves. (a) Continuous interpolation between authentic and scrambled priors $\alpha \in [0.0, 1.0]$: on Penmanshiel, the tested corruption trajectory crosses the unconstrained baseline around an empirical crossover region of $\alpha \approx 0.07$. (b) Turbine aerodynamic aging: capacity derating exceeding 10\% flips nominal physical priors into economic penalties under the evaluated configuration. (c) Anemometer sensor calibration drift: Penmanshiel retains an advantage under positive wind speed drift up to $+15\%$, whereas negative sensor under-reporting systematically inflates shortfall.}}{16}{figure.caption.22}\protected@file@percent }
\newlabel{fig:corruption_gradient}{{4}{16}{Continuous Prior Corruption and Engineering Drift Severity Response Curves. (a) Continuous interpolation between authentic and scrambled priors $\alpha \in [0.0, 1.0]$: on Penmanshiel, the tested corruption trajectory crosses the unconstrained baseline around an empirical crossover region of $\alpha \approx 0.07$. (b) Turbine aerodynamic aging: capacity derating exceeding 10\% flips nominal physical priors into economic penalties under the evaluated configuration. (c) Anemometer sensor calibration drift: Penmanshiel retains an advantage under positive wind speed drift up to $+15\%$, whereas negative sensor under-reporting systematically inflates shortfall}{figure.caption.22}{}}
